          }
        }
      }
    },
    "MiSTer가 켜져 있고 랜선이나 Wi-Fi가 연결되어 있는지 확인하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the MiSTer is on and connected by Ethernet cable or Wi-Fi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiSTer가 켜져 있고 랜선이나 Wi-Fi가 연결되어 있는지 확인하세요."
